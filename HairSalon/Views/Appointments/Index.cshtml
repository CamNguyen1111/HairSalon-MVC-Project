@model IEnumerable<HairSalon.Models.Appointment>
@{
    ViewData["Title"] = "Quản lý Lịch hẹn";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="fw-bold"><i class="fa-solid fa-calendar-check text-success me-2"></i>Quản lý Lịch hẹn</h2>
</div>

<div class="card shadow-sm border-0 overflow-hidden">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="px-4 py-3">Ngày - Giờ</th>
                    <th class="py-3">Khách hàng</th>
                    <th class="py-3">Dịch vụ</th>
                    <th class="py-3">Thợ cắt tóc</th>
                    <th class="py-3" style="width: 220px;">Trạng thái</th>
                    <th class="text-end px-4 py-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="align-middle">
                        <td class="px-4 fw-bold text-dark">
                            <i class="fa-regular fa-calendar text-muted me-1"></i> @item.AppointmentDate.ToString("dd/MM/yyyy") <br />
                            <i class="fa-regular fa-clock text-warning me-1"></i> @item.StartTime
                        </td>
                        <td><i class="fa-solid fa-user-tag text-muted me-1"></i> @(item.Customer?.FullName ?? "Khách vãng lai")</td>
                        <td class="text-primary fw-medium">@(item.Service?.ServiceName ?? "Trống")</td>
                        <td>@(item.Staff?.FullName ?? "Chưa phân công")</td>
                        <td>
                            <!-- Form cập nhật trạng thái nhanh bọc trong Input Group -->
                            <form asp-action="UpdateStatus" method="post" class="d-flex">
                                <input type="hidden" name="id" value="@item.AppointmentId" />
                                <div class="input-group input-group-sm shadow-sm">
                                    <select name="status" class="form-select border-0 bg-light">
                                        <option value="Pending" selected="@(item.Status == "Pending")">Chờ xác nhận</option>
                                        <option value="Confirmed" selected="@(item.Status == "Confirmed")">Đã xác nhận</option>
                                        <option value="Completed" selected="@(item.Status == "Completed")">Hoàn thành</option>
                                        <option value="Canceled" selected="@(item.Status == "Canceled")">Đã hủy</option>
                                    </select>
                                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check"></i></button>
                                </div>
                            </form>
                        </td>
                        <td class="text-end px-4">
                            <a asp-action="Details" asp-route-id="@item.AppointmentId" class="btn btn-sm btn-outline-info rounded-pill px-3">
                                <i class="fa-solid fa-circle-info"></i> Chi tiết
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.AppointmentId" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                <i class="fa-solid fa-trash"></i> Xóa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>