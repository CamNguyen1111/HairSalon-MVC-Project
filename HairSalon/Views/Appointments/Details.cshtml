@model HairSalon.Models.Appointment

@{
    ViewData["Title"] = "Chi tiết Lịch hẹn";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="fw-bold"><i class="fa-solid fa-circle-info text-info me-2"></i>Chi tiết Lịch hẹn</h2>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 fw-bold">
        <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-dark text-white p-4 text-center">
                <h4 class="mb-0 fw-bold">MÃ LỊCH HẸN: #@Model.AppointmentId</h4>
                <p class="mb-0 text-warning mt-1">
                    Trạng thái:
                    @if (Model.Status == "Pending")
                    {
                        <span>Chờ xác nhận</span>
                    }
                    else if (Model.Status == "Confirmed")
                    {
                        <span>Đã xác nhận</span>
                    }
                    else if (Model.Status == "Completed")
                    {
                        <span>Hoàn thành</span>
                    }
                    else
                    {
                        <span>Đã hủy</span>
                    }
                </p>
            </div>
            <div class="card-body p-4 p-md-5 bg-white">
                <div class="row mb-4">
                    <div class="col-sm-4 fw-bold text-muted">Thời gian:</div>
                    <div class="col-sm-8 text-dark fw-bold fs-5">
                        <i class="fa-regular fa-calendar-days text-primary me-2"></i>@Model.AppointmentDate.ToString("dd/MM/yyyy") lúc @Model.StartTime
                    </div>
                </div>
                <div class="row mb-4">
                    <div class="col-sm-4 fw-bold text-muted">Khách hàng:</div>
                    <div class="col-sm-8 fw-medium">
                        <i class="fa-solid fa-user text-muted me-2"></i>@(Model.Customer?.FullName ?? "N/A")
                    </div>
                </div>
                <div class="row mb-4">
                    <div class="col-sm-4 fw-bold text-muted">Dịch vụ:</div>
                    <div class="col-sm-8 fw-medium text-danger">
                        <i class="fa-solid fa-scissors me-2"></i>@(Model.Service?.ServiceName ?? "N/A")
                    </div>
                </div>
                <div class="row mb-4">
                    <div class="col-sm-4 fw-bold text-muted">Thợ cắt tóc:</div>
                    <div class="col-sm-8 fw-medium">
                        <i class="fa-solid fa-id-badge text-muted me-2"></i>@(Model.Staff?.FullName ?? "Chưa phân công")
                    </div>
                </div>
                <div class="row mb-4">
                    <div class="col-sm-4 fw-bold text-muted">Ngày tạo:</div>
                    <div class="col-sm-8 text-muted">@Model.CreatedAt</div>
                </div>

                <hr class="my-4" />

                <div class="row">
                    <div class="col-12 fw-bold text-muted mb-2"><i class="fa-regular fa-comment-dots me-2"></i>Ghi chú của khách:</div>
                    <div class="col-12 p-3 bg-light rounded-3 border">
                        @(string.IsNullOrEmpty(Model.Notes) ? "Không có ghi chú." : Model.Notes)
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white p-4 border-0 text-center">
                <a asp-action="Edit" asp-route-id="@Model.AppointmentId" class="btn btn-warning rounded-pill px-4 fw-bold text-white me-2">
                    <i class="fa-solid fa-pen"></i> Chỉnh sửa
                </a>
            </div>
        </div>
    </div>
</div>