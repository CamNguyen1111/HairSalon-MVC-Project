@model HairSalon.Models.Service

@{
    ViewData["Title"] = "Cập nhật Dịch vụ";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="fw-bold"><i class="fa-solid fa-pen-to-square text-primary me-2"></i>Cập nhật Dịch vụ</h2>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 fw-bold">
        <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-4 p-4 p-md-5 bg-white">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>
                <input type="hidden" asp-for="ServiceId" />

                <div class="row g-4">
                    <div class="col-md-12">
                        <label asp-for="ServiceName" class="form-label fw-bold text-muted small">TÊN DỊCH VỤ <span class="text-danger">*</span></label>
                        <input asp-for="ServiceName" class="form-control form-control-lg bg-light border-0 shadow-sm" required />
                        <span asp-validation-for="ServiceName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label fw-bold text-muted small">GIÁ TIỀN (VNĐ) <span class="text-danger">*</span></label>
                        <div class="input-group input-group-lg shadow-sm rounded-3 overflow-hidden">
                            <input asp-for="Price" type="number" class="form-control bg-light border-0" required min="0" />
                            <span class="input-group-text bg-light border-0 text-muted fw-bold">đ</span>
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DurationMinutes" class="form-label fw-bold text-muted small">THỜI GIAN <span class="text-danger">*</span></label>
                        <div class="input-group input-group-lg shadow-sm rounded-3 overflow-hidden">
                            <input asp-for="DurationMinutes" type="number" class="form-control bg-light border-0" required min="1" />
                            <span class="input-group-text bg-light border-0 text-muted fw-bold">Phút</span>
                        </div>
                        <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Description" class="form-label fw-bold text-muted small">MÔ TẢ CHI TIẾT</label>
                        <textarea asp-for="Description" class="form-control form-control-lg bg-light border-0 shadow-sm" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>
                <hr class="my-5 text-muted" />
                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow">
                        <i class="fa-solid fa-floppy-disk me-2"></i> LƯU THAY ĐỔI
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>