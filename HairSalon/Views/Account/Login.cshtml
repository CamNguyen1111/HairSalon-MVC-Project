@{
    ViewData["Title"] = "Đăng nhập hệ thống";
}
<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-lg border-0 rounded-4 p-4 bg-white">
            <div class="text-center mb-4">
                <div class="bg-warning rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 60px; height: 60px;">
                    <i class="fa-solid fa-lock fs-3 text-white"></i>
                </div>
                <h3 class="fw-bold text-dark">Chào mừng trở lại!</h3>
                <p class="text-muted small">Vui lòng đăng nhập để tiếp tục</p>
            </div>

            <!-- Báo đăng ký thành công -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success text-center rounded-3 fw-bold">
                    <i class="fa-solid fa-circle-check me-1"></i> @TempData["SuccessMessage"]
                </div>
            }

            <!-- Báo lỗi sai mật khẩu -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger rounded-3 small text-center">
                    @Html.ValidationSummary(false, "", new { @class = "text-danger mb-0 list-unstyled" })
                </div>
            }

            <form asp-action="Login" method="post">
                <div class="form-group mb-3">
                    <label class="form-label fw-bold text-muted small">TÊN ĐĂNG NHẬP</label>
                    <div class="input-group input-group-lg shadow-sm rounded-3 overflow-hidden">
                        <span class="input-group-text bg-light border-0"><i class="fa-solid fa-user text-muted"></i></span>
                        <input type="text" name="username" class="form-control bg-light border-0" placeholder="Nhập tài khoản..." required />
                    </div>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label fw-bold text-muted small">MẬT KHẨU</label>
                    <div class="input-group input-group-lg shadow-sm rounded-3 overflow-hidden">
                        <span class="input-group-text bg-light border-0"><i class="fa-solid fa-key text-muted"></i></span>
                        <input type="password" name="password" class="form-control bg-light border-0" placeholder="Nhập mật khẩu..." required />
                    </div>
                </div>

                <button type="submit" class="btn btn-warning btn-lg rounded-pill w-100 fw-bold shadow text-white">
                    ĐĂNG NHẬP
                </button>

                <div class="text-center mt-4">
                    <span class="text-muted">Chưa có tài khoản?</span>
                    <a asp-action="Register" class="text-primary fw-bold text-decoration-none">Đăng ký ngay</a>
                </div>
            </form>
        </div>
    </div>
</div>